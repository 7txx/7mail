# ============================================
# CunMail 配置文件
# ============================================

# ---- 必需配置 ----
# D1 数据库名称（你在 Cloudflare 上创建的 D1 数据库名）
D1_DATABASE_NAME=cunmail
# D1 数据库 ID（在 Cloudflare 控制台查看）
D1_DATABASE_ID=replace-with-d1-database-id

# 邮箱域名（你要用来收邮件的域名，多个用逗号分隔）
EMAIL_DOMAIN=example.com

# Cookie 加密密钥（随便填一串随机字符，越长越安全）
COOKIES_SECRET=replace-with-a-random-secret-string

# ---- 可选配置 - 人机验证 ----
# Cloudflare Turnstile 人机验证（不填则关闭验证）
TURNSTILE_KEY=
TURNSTILE_SECRET=

# ---- 可选配置 - 站点密码 ----
# 站点访问密码（不填则公开访问）
PASSWORD=

# ---- 可选配置 - 发邮件功能 ----
# 发送通道：resend / mailchannels / cloudflare（默认 resend，免费可用）
# cloudflare 通道需要 Cloudflare Pro 版（$5/月），免费版用不了
SEND_CHANNEL=resend
# 发件人邮箱（开启发邮件功能时必填，必须是已验证的域名邮箱）
SENDER_EMAIL=no-reply@example.com
# Mailbox Token 密钥（开启发邮件功能时必填，随机字符串）
MAILBOX_TOKEN_SECRET=
# Resend API Key（用 resend 通道时填，免费版 100 封/天）
RESEND_API_KEY=
# MailChannels API Key（用 mailchannels 通道时填）
MAILCHANNELS_API_KEY=
# 每个邮箱每分钟发送限制（默认 3）
SEND_RATE_LIMIT_PER_MINUTE=3
# 每个 IP 每分钟发送限制（默认 10）
SEND_IP_RATE_LIMIT_PER_MINUTE=10

# ---- 可选配置 - Gmail 无限别名 ----
# 原理:Gmail 忽略用户名中的点和 + 后的内容,所有别名都投递到同一个真实 Gmail 账号
#
# 【转发模式(推荐,只需下面两项)】
# 1. 准备一个专用的 Gmail 账号(不要用私人账号,所有别名邮件都会进它)
# 2. Gmail 设置 -> 转发和 POP/IMAP -> 添加转发地址,填系统自动生成的转发地址
#    (部署后访问 /config 查看 gmailSyncAddress 字段,或 GET /api/gmail/forward-inbox 查看验证码)
# 3. 选择"将收到的邮件转发给该地址"保存
# 邮件会实时经 Cloudflare 邮件路由进入系统,无需任何 Google API 凭证
#
# 注意:转发地址必须是能收邮件的域名,即必须配置 EMAIL_DOMAIN(自定义域名),
# Cloudflare 分配的 workers.dev 免费域名不支持收邮件,无法用于转发模式。
#
# 是否启用(填 true 才生效)
GMAIL_ENABLED=false
# 真实的 Gmail 账号(别名母账号,例如 yourname@gmail.com)
GMAIL_ADDRESS=
# 转发收信地址(留空则自动使用 gmail-sync@你的第一个 EMAIL_DOMAIN 域名,一般不用填)
GMAIL_SYNC_ADDRESS=
#
# 【API 轮询模式(可选,不推荐,需 Google OAuth)】
# Google Cloud 项目 -> 启用 Gmail API -> OAuth 客户端 ID(桌面应用)
# -> 生成 refresh token(授权范围 gmail.readonly)
# 注意:gmail.readonly 是受限 scope,OAuth 测试模式 refresh token 7 天过期
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- 可选配置 - 其他 ----
# API 调用频率限制（每分钟，默认 100）
API_RATE_LIMIT_PER_MINUTE=100
# 是否显示推广链接（默认 false）
SHOW_AFF=false
# 是否开启 OpenAPI（默认 false）
ENABLE_OPENAPI=false
